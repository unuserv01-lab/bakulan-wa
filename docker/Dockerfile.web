FROM node:22-bookworm-slim

# Frontend tidak memakai package-lock sendiri (lockfile ada di root repo
# untuk workspace), jadi pakai npm install, bukan npm ci, supaya build
# tidak gagal hanya karena lockfile web belum ada.
ARG NEXT_PUBLIC_API_URL=http://localhost:3001
ENV NEXT_PUBLIC_API_URL=$NEXT_PUBLIC_API_URL
ENV NODE_ENV=production

WORKDIR /app
COPY apps/web/package.json ./package.json
COPY apps/web/next.config.mjs ./next.config.mjs
COPY apps/web/tsconfig.json ./tsconfig.json
COPY apps/web/public ./public
COPY apps/web/app ./app
COPY apps/web/components ./components
COPY apps/web/lib ./lib

RUN npm install --no-audit --no-fund \
    && npm run build

EXPOSE 3000
CMD ["npm", "run", "start"]
