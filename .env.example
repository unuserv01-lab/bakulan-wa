# ===== Bakulan WA — environment =====
# Salin ke .env lalu isi. JANGAN commit .env.

NODE_ENV=development
LOG_LEVEL=info

# ---- Postgres ----
# POSTGRES_PASSWORD dipakai docker compose; DATABASE_URL dipakai saat dev lokal.
# (Di Docker, DATABASE_URL & REDIS_URL otomatis di-override ke hostname service.)
POSTGRES_PASSWORD=ganti-dengan-password-kuat
DATABASE_URL="postgresql://bakulan:ganti-dengan-password-kuat@localhost:5432/bakulan_wa?schema=public"

# ---- Redis ----
REDIS_URL="redis://localhost:6379"

# ---- Public ----
# Domain API untuk Caddy (HTTPS otomatis). Contoh: api.bakulanwa.id
API_DOMAIN=localhost
# Origin dashboard yang boleh akses API (pisahkan dengan koma kalau lebih dari satu)
WEB_ORIGIN="http://localhost:3000"
# URL API yang bisa dibuka BROWSER untuk dashboard web (dibaca saat build web).
# Lokal: http://localhost:3001
# Codespaces: URL forward port 3001, dan WEB_ORIGIN di atas harus berisi
# URL forward port 3000 supaya tidak kena CORS.
WEB_PUBLIC_API_URL="http://localhost:3001"
# PENTING: isi .env ini secara manual di komputermu sendiri.
# Jangan tempel nilai rahasia (JWT, SESSION_ENCRYPTION_KEY, API key AI,
# Midtrans) ke chat AI mana pun, termasuk yang gratisan. AI boleh menjelaskan
# arti tiap field, tapi nilai rahasianya dibuat lokal dengan openssl / dashboard
# provider, bukan lewat chat.

# ---- Auth ----
# Generate: openssl rand -base64 48
JWT_ACCESS_SECRET="ganti-minimal-32-karakter-acak-acak-acak"
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS=30

# ---- Enkripsi sesi WhatsApp (auth state Baileys di DB) ----
# WAJIB 32 byte base64. Generate: openssl rand -base64 32
# Kalau key ini hilang/berganti, SEMUA tenant harus scan QR ulang. Backup di tempat aman.
SESSION_ENCRYPTION_KEY=""

# ---- AI provider (OpenAI-compatible chat completions) ----
AI_DEFAULT_PROVIDER=deepseek
DEEPSEEK_API_KEY=""
DEEPSEEK_BASE_URL="https://api.deepseek.com"
DEEPSEEK_MODEL="deepseek-chat"
DASHSCOPE_API_KEY=""
DASHSCOPE_BASE_URL="https://dashscope-intl.aliyuncs.com/compatible-mode/v1"
QWEN_MODEL="qwen-plus"

# Harga modal per 1 juta token (USD). NILAI DI BAWAH ADALAH PLACEHOLDER —
# cek harga resmi di dashboard provider sebelum menagih tenant.
DEEPSEEK_PRICE_IN_USD_PER_M=0.28
DEEPSEEK_PRICE_OUT_USD_PER_M=0.42
QWEN_PRICE_IN_USD_PER_M=0.40
QWEN_PRICE_OUT_USD_PER_M=1.20
AI_USD_IDR_RATE=17900
# Tenant ditagih = biaya modal x multiplier ini
AI_BILLING_MARGIN_MULTIPLIER=1.75
AI_MAX_OUTPUT_TOKENS=400

# ---- Perilaku balasan ----
MEMORY_MESSAGE_LIMIT=10
# Saldo minimum (IDR) agar AI mau membalas; di bawah ini kirim pesan fallback netral
MIN_BALANCE_TO_REPLY_IDR=50
# Pesan masuk yang lebih tua dari ini (detik) diabaikan (mencegah banjir balasan setelah downtime)
MAX_MESSAGE_AGE_SECONDS=600
# Setelah pemilik balas manual dari HP, AI diam selama ini (detik)
HANDOVER_TTL_SECONDS=3600

# ---- Midtrans ----
MIDTRANS_SERVER_KEY=""
MIDTRANS_CLIENT_KEY=""
MIDTRANS_IS_PRODUCTION=false
TOPUP_MIN_IDR=10000
TOPUP_MAX_IDR=5000000

# ---- Alert ke kamu (opsional; kalau kosong hanya masuk log) ----
ALERT_TELEGRAM_BOT_TOKEN=""
ALERT_TELEGRAM_CHAT_ID=""

# ---- Ports ----
API_PORT=3001
WA_WORKER_HEALTH_PORT=3002
AI_WORKER_HEALTH_PORT=3003
